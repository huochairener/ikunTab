# ikun-tab 备用站环境变量（复制为 .env 使用；生产环境请配置到 ESA 控制台的「函数变量」）
# 命名与 Python 主站保持一致（IKUN_ 前缀）。

# ---------- 运行模式 ----------
# mirror 只读镜像（默认，**推荐**）：数据全部来自 KV 快照，由主站主动推送。
#        主站宕机时备用站仍可登录、浏览书签——这是「容灾」场景唯一可行的模式。
# auto   配了 MySQL 就直连；否则回退主站代理
# direct 只用 MySQL（需要支持 TCP 的 Node 运行时）
# proxy  只用主站代理（主站宕机备用站就废了，仅用于临时排障）
IKUN_DATA_SOURCE=mirror

# ---------- 边缘存储（EdgeKV 只读镜像）----------
# ESA 通过**环境变量**指定存储空间名（不是绑定句柄）。
# 值填「边缘计算 → 边缘存储」里创建的存储空间名称，区分大小写。
IKUN_KV_NAMESPACE=
# 主站推送 /api/sync 时使用的共享密钥，需与推送脚本的 IKUN_SYNC_SECRET 一致
IKUN_SYNC_SECRET=

# ---------- 主站地址（仅镜像模式下用于 /uploads 静态资源回源）----------
IKUN_API_ORIGIN=
IKUN_UPLOAD_ORIGIN=

# ---------- 数据推送（scripts/push.sh / sync-push.mjs 使用）----------
# 备用站地址，结尾不带 /
IKUN_SYNC_URL=
# 备用站登录用的账号名（与主站账号完全一致）
IKUN_MIRROR_USERNAME=
# 备用站登录用的明文密码（仅用于本地算轻量哈希，不会上传或存进 KV）
IKUN_MIRROR_PASSWORD=

# ---------- MySQL 直连（推送脚本读取主站数据用；auto/direct 模式也用它）----------
IKUN_MYSQL_HOST=127.0.0.1
IKUN_MYSQL_PORT=3306
IKUN_MYSQL_DB=ikuntab
IKUN_MYSQL_USER=root
IKUN_MYSQL_PASSWORD=
IKUN_MYSQL_SSL=0

# ---------- JWT（与主站共用同一套登录态时必须一致）----------
IKUN_JWT_SECRET=
IKUN_JWT_COOKIE_NAME=ikun_token
IKUN_JWT_EXPIRE_MINUTES=43200

# ---------- 第三方代理 ----------
IKUN_HOTLIST_API_URL=
IKUN_WEATHER_CACHE_MINUTES=30
IKUN_HOTLIST_CACHE_MINUTES=20
