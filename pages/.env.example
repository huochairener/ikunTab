# ikun-tab 备用站本地开发环境变量（复制为 .env 使用；生产环境请配置到 ESA 控制台的「函数变量」）
# 命名与 Python 主站完全一致（IKUN_ 前缀），可直接复用同一套配置。

# ---------- 数据来源 ----------
# auto   默认：配置了 MySQL 就直连；没配置或当前运行时/数据库不可用时转发主站
# direct 只用 MySQL 直连（需要能跑 mysql2 的 Node 运行时；ESA 边缘函数无 TCP，直连不可用）
# proxy  只转发到 Python 主站（ESA 边缘函数上的推荐模式）
IKUN_DATA_SOURCE=auto

# Python 主站地址（proxy / auto 兜底模式必填；结尾不要带 /）
# 例：https://ikun.example.com
IKUN_API_ORIGIN=

# 上传文件回源地址（默认同 IKUN_API_ORIGIN，一般不用单独设置）
IKUN_UPLOAD_ORIGIN=

# ---------- MySQL 直连（Node 运行时可用；ESA 边缘函数无 TCP 不可用）----------
IKUN_MYSQL_HOST=127.0.0.1
IKUN_MYSQL_PORT=3306
IKUN_MYSQL_DB=ikuntab
IKUN_MYSQL_USER=root
IKUN_MYSQL_PASSWORD=
# 是否走 TLS（自签/免验证），默认关
IKUN_MYSQL_SSL=0

# ---------- JWT（与主站共用同一套数据库时的关键配置）----------
# 必须与 Python 主站实际的 JWT_SECRET 一致（docker-compose 部署时即其 JWT_SECRET 环境变量），
# 这样主站签发的登录态在备用站直连模式下同样有效。
IKUN_JWT_SECRET=
# Cookie 名（与主站一致即可）
IKUN_JWT_COOKIE_NAME=ikun_token
# token 有效期（分钟），默认 43200（30 天），与主站默认一致
IKUN_JWT_EXPIRE_MINUTES=

# ---------- 第三方代理 ----------
# 热榜聚合服务地址（与主站一致；未配置时热搜返回空列表）
IKUN_HOTLIST_API_URL=
IKUN_WEATHER_CACHE_MINUTES=30
IKUN_HOTLIST_CACHE_MINUTES=20
